# Copy to .env (gitignored). All values below are placeholders.

# Deterministic offline mode (default). Set to 0 to use a real model.
MOCK_LLM=1

# Only needed when MOCK_LLM=0.
ANTHROPIC_API_KEY=DEMO_ONLY_NOT_A_REAL_TOKEN
ANTHROPIC_MODEL_ID=claude-sonnet-5-5

# Where JSON-lines trace spans are written (gitignored).
NORTHWIND_TRACE_DIR=./traces

# Log level for CLI output on stderr (DEBUG, INFO, WARNING, ERROR).
NORTHWIND_LOG_LEVEL=WARNING

# Kill switch: set to 1 to halt both agents before their next step,
# or create the flag file below (uv run demo kill-switch on).
NORTHWIND_KILL_SWITCH=0
NORTHWIND_KILL_SWITCH_FILE=./.killswitch
